// EJERCICIO 48: FIGURAS GEOMETRICAS

trait Figura {
  def area: Double
}

class Rectangulo(val base: Double, val altura: Double) extends Figura {
  override def area: Double = {
    base * altura
  }
}

class Circulo(val radio: Double) extends Figura {
  override def area: Double = {
    math.Pi * radio * radio
  }
}

class Triangulo(val base: Double, val altura: Double) extends Figura {
  override def area: Double = {
    (base * altura) / 2
  }
}

def mostrarArea(figura: Figura): Double = {
  figura.area
}


// EJERCICIO 49: ANIMALES Y CAPACIDADES

abstract class Animal(val nombre: String) {
  def sonido(): String
}

trait Volador {
  def volar(): String
}

trait Nadador {
  def nadar(): String
}

class Perro(nombre: String) extends Animal(nombre) {
  override def sonido(): String = {
    "Guau"
  }
}

class Pato(nombre: String)
  extends Animal(nombre)
  with Volador
  with Nadador {

  override def sonido(): String = {
    "Cuac"
  }

  override def volar(): String = {
    "El pato esta volando"
  }

  override def nadar(): String = {
    "El pato esta nadando"
  }
}

class Pez(nombre: String) extends Animal(nombre) with Nadador {
  override def sonido(): String = {
    "Glub"
  }

  override def nadar(): String = {
    "El pez esta nadando"
  }
}


// EJERCICIO 50: EMPLEADOS

abstract class Empleado(
  val nombre: String,
  val salarioBase: Double
) {
  def salarioTotal: Double
}

class Desarrollador(
  nombre: String,
  salarioBase: Double,
  val bono: Double
) extends Empleado(nombre, salarioBase) {

  override def salarioTotal: Double = {
    salarioBase + bono
  }
}

class Vendedor(
  nombre: String,
  salarioBase: Double,
  val ventas: Double,
  val porcentajeComision: Double
) extends Empleado(nombre, salarioBase) {

  override def salarioTotal: Double = {
    salarioBase + (ventas * porcentajeComision / 100)
  }
}

class Gerente(
  nombre: String,
  salarioBase: Double,
  val porcentajeBono: Double
) extends Empleado(nombre, salarioBase) {

  override def salarioTotal: Double = {
    salarioBase + (salarioBase * porcentajeBono / 100)
  }
}


// EJERCICIO 51: SISTEMA DE NOTIFICACIONES

trait Notificacion {
  def enviar(mensaje: String): String
}

class Email extends Notificacion {
  override def enviar(mensaje: String): String = {
    "Enviando correo: " + mensaje
  }
}

class SMS extends Notificacion {
  override def enviar(mensaje: String): String = {
    "Enviando SMS: " + mensaje
  }
}

class Push extends Notificacion {
  override def enviar(mensaje: String): String = {
    "Enviando notificacion: " + mensaje
  }
}

def procesarNotificacion(
  notificacion: Notificacion,
  mensaje: String
): String = {
  notificacion.enviar(mensaje)
}


// EJERCICIO 52: VEHICULOS

abstract class Vehiculo(
  val marca: String,
  val velocidadMaxima: Double
) {
  def descripcion(): String
}

trait Electrico {
  def tipoMotor(): String
}

trait Recargable {
  def recargar(): String
}

class Automovil(
  marca: String,
  velocidadMaxima: Double
) extends Vehiculo(marca, velocidadMaxima) {

  override def descripcion(): String = {
    "Automovil " + marca +
      ", velocidad maxima: " + velocidadMaxima + " km/h"
  }
}

class Motocicleta(
  marca: String,
  velocidadMaxima: Double
) extends Vehiculo(marca, velocidadMaxima) {

  override def descripcion(): String = {
    "Motocicleta " + marca +
      ", velocidad maxima: " + velocidadMaxima + " km/h"
  }
}

class AutoElectrico(
  marca: String,
  velocidadMaxima: Double
) extends Vehiculo(marca, velocidadMaxima)
    with Electrico
    with Recargable {

  override def descripcion(): String = {
    "Auto electrico " + marca +
      ", velocidad maxima: " + velocidadMaxima + " km/h"
  }

  override def tipoMotor(): String = {
    "Motor electrico"
  }

  override def recargar(): String = {
    "Cargando bateria"
  }
}


